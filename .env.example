# --- Telegram (get api_id/api_hash from https://my.telegram.org) ---
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=trader_session

# --- Pocket Option (see README.md "Getting your SSID" section) ---
PO_SESSION=paste_your_session_string_here
PO_UID=1234589
PO_IS_DEMO=1

# --- Trading ---
STARTING_STAKE=1.0
MARTINGALE_MULTIPLIER=2.0
MAX_MARTINGALE_LEVEL=3
MAX_DAILY_LOSS=50
DEFAULT_EXPIRATION_SECONDS=300

# Hours offset from UTC your signal channels use, when a signal doesn't
# state its own zone in the message (e.g. "Time Zone: UTC -3" is detected
# automatically per-signal; this is only the fallback default).
SIGNAL_UTC_OFFSET_HOURS=0

# Safety cap: skip a signal instead of sleeping for hours if the computed
# wait until its entry time is longer than this (likely a timezone/clock
# issue rather than a real signal).
MAX_ENTRY_WAIT_SECONDS=3600

# How long the bot waits for a second half of a signal split across
# multiple messages before giving up on it.
MULTI_MESSAGE_WINDOW_SECONDS=180
